# 真实内网接口模式：由 all(1).md 的接口文档导入到 Apifox 后对应的服务地址。
# 使用 pnpm dev:api 启动；本地原型模式 pnpm dev 仍保持 Mock，不会被影响。
VITE_USE_MOCK=false
# 接口文档未覆盖的原型模块自动保留 Mock，避免页面因 404 而空白。
VITE_API_FALLBACK_TO_MOCK=true
VITE_BASE_URL='http://192.168.168.36:48081'
VITE_API_URL=/admin-api
VITE_APP_CAPTCHA_ENABLE=false

# 与现有 .env.dev 保持一致的前端构建配置
VITE_API_BASEPATH=/dev-api
VITE_BASE_PATH='/'
VITE_OUT_DIR=dist
VITE_SOURCEMAP=false
